<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the Flutter engine is warming up (Android ≤ 11).
     On Android 12+ the OS shows the adaptive icon automatically before this. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same background the app uses so there is no colour flash -->
    <item android:drawable="?android:colorBackground" />
    <!-- Centre the same icon that the OS splash shows on Android 12+ -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
